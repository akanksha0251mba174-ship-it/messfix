rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Primitives & Helpers
    // -------------------------------------------------------------------------

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'akanksha.0251mba174@dgu.ac.in';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isMessOwner(messId) {
      return isVerifiedUser() &&
        get(/databases/$(database)/documents/messes/$(messId)).data.ownerId == request.auth.uid;
    }

    function isMessOperator(messId) {
      return isVerifiedUser() && (
        isMessOwner(messId) ||
        exists(/databases/$(database)/documents/messes/$(messId)/operators/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'activeMessId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('activeMessId' in data) || (data.activeMessId is string && data.activeMessId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'hostelRoom', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('hostelRoom' in data) || (data.hostelRoom is string && data.hostelRoom.size() <= 40))
        && data.updatedAt is timestamp;
    }

    function isValidMess(data, messId) {
      return data.keys().hasAll([
          'id', 'name', 'campusOrArea', 'type', 'ownerId', 'ownerName',
          'breakfastTiming', 'lunchTiming', 'snacksTiming', 'dinnerTiming',
          'announcement', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'campusOrArea', 'type', 'ownerId', 'ownerName',
          'breakfastTiming', 'lunchTiming', 'snacksTiming', 'dinnerTiming',
          'announcement', 'isActive', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == messId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.campusOrArea is string && data.campusOrArea.size() >= 2 && data.campusOrArea.size() <= 100
        && data.type in ['College Hostel', 'Campus Central', 'Private PG Mess']
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
        && data.breakfastTiming is string && data.breakfastTiming.size() <= 50
        && data.lunchTiming is string && data.lunchTiming.size() <= 50
        && data.snacksTiming is string && data.snacksTiming.size() <= 50
        && data.dinnerTiming is string && data.dinnerTiming.size() <= 50
        && data.announcement is string && data.announcement.size() <= 300
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessOperator(data, messId, operatorId) {
      return data.keys().hasAll(['uid', 'messId', 'displayName', 'roleLabel', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'messId', 'displayName', 'roleLabel', 'addedBy', 'createdAt'])
        && isValidId(data.uid) && data.uid == operatorId
        && isValidId(data.messId) && data.messId == messId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.roleLabel in ['Mess Manager', 'Hostel Warden', 'Student Rep']
        && isValidId(data.addedBy)
        && data.createdAt is timestamp;
    }

    function isValidMenuItemsList(items) {
      return items is list
        && items.size() <= 12
        && (items.size() == 0 || (items[0] is string && items[0].size() >= 1 && items[0].size() <= 60));
    }

    function isValidDailyMenu(data, messId, menuId) {
      return data.keys().hasAll([
          'messId', 'date', 'breakfastItems', 'lunchItems', 'snacksItems',
          'dinnerItems', 'specialNote', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'messId', 'date', 'breakfastItems', 'lunchItems', 'snacksItems',
          'dinnerItems', 'specialNote', 'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.messId) && data.messId == messId
        && isValidDateStr(data.date) && data.date == menuId
        && isValidMenuItemsList(data.breakfastItems)
        && isValidMenuItemsList(data.lunchItems)
        && isValidMenuItemsList(data.snacksItems)
        && isValidMenuItemsList(data.dinnerItems)
        && data.specialNote is string && data.specialNote.size() <= 240
        && isValidId(data.updatedBy)
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMealRating(data, messId) {
      return data.keys().hasAll([
          'messId', 'date', 'mealType', 'rating', 'hygieneRating',
          'portionAdequate', 'comment', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'messId', 'date', 'mealType', 'rating', 'hygieneRating',
          'portionAdequate', 'comment', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.messId) && data.messId == messId
        && isValidDateStr(data.date)
        && data.mealType in ['Breakfast', 'Lunch', 'Snacks', 'Dinner']
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.hygieneRating is int && data.hygieneRating >= 1 && data.hygieneRating <= 5
        && data.portionAdequate is bool
        && data.comment is string && data.comment.size() <= 400
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComplaint(data, messId) {
      return data.keys().hasAll([
          'messId', 'title', 'description', 'category', 'mealType', 'mealDate',
          'status', 'operatorResponse', 'respondedByName', 'authorId', 'authorName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'messId', 'title', 'description', 'category', 'mealType', 'mealDate',
          'status', 'operatorResponse', 'respondedByName', 'authorId', 'authorName',
          'createdAt', 'updatedAt', 'resolvedAt'
        ])
        && isValidId(data.messId) && data.messId == messId
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1000
        && data.category in [
          'Food Quality', 'Hygiene & Cleanliness', 'Portion Size',
          'Menu / Timing Mismatch', 'Service & Staff', 'Missed Meal'
        ]
        && data.mealType in ['Breakfast', 'Lunch', 'Snacks', 'Dinner', 'General']
        && isValidDateStr(data.mealDate)
        && data.status in ['Submitted', 'Acknowledged', 'In Review', 'Resolved']
        && data.operatorResponse is string && data.operatorResponse.size() <= 800
        && data.respondedByName is string && data.respondedByName.size() <= 80
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('resolvedAt' in data) || data.resolvedAt is timestamp);
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create, update, delete: if isValidId(userId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && isOwner(userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'activeMessId', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && isOwner(userId)
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'hostelRoom', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /messes/{messId} {
      allow get: if isSignedIn() && isValidId(messId);
      allow list: if isSignedIn() && (
        resource.data.isActive == true ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(messId)
        && isValidMess(incoming(), messId)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(messId)
        && isValidMess(incoming(), messId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isMessOperator(messId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'campusOrArea', 'type', 'ownerName',
              'breakfastTiming', 'lunchTiming', 'snacksTiming', 'dinnerTiming',
              'announcement', 'isActive', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(messId) && (isMessOwner(messId) || isAdmin());

      match /operators/{operatorId} {
        allow get: if isSignedIn() && isValidId(messId) && isValidId(operatorId)
          && (request.auth.uid == operatorId || isMessOwner(messId) || isAdmin());
        allow list: if isSignedIn() && resource.data.messId == messId && resource.data.uid == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(operatorId)
          && isValidMessOperator(incoming(), messId, operatorId)
          && exists(/databases/$(database)/documents/messes/$(messId))
          && (isMessOwner(messId) || isAdmin())
          && incoming().addedBy == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(operatorId)
          && (isMessOwner(messId) || isAdmin());
      }

      match /menus/{menuId} {
        allow get: if isSignedIn() && isValidId(messId) && isValidId(menuId);
        allow list: if isSignedIn() && resource.data.messId == messId;
        allow create: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(menuId)
          && isValidDailyMenu(incoming(), messId, menuId)
          && exists(/databases/$(database)/documents/messes/$(messId))
          && (isMessOperator(messId) || isAdmin())
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(menuId)
          && isValidDailyMenu(incoming(), messId, menuId)
          && (isMessOperator(messId) || isAdmin())
          && incoming().messId == existing().messId
          && incoming().date == existing().date
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'breakfastItems', 'lunchItems', 'snacksItems', 'dinnerItems',
            'specialNote', 'updatedBy', 'updatedByName', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isValidId(messId) && isValidId(menuId) && (isMessOwner(messId) || isAdmin());
      }

      match /ratings/{ratingId} {
        allow get: if isSignedIn() && isValidId(messId) && isValidId(ratingId);
        allow list: if isSignedIn() && resource.data.messId == messId;
        allow create: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(ratingId)
          && isValidMealRating(incoming(), messId)
          && exists(/databases/$(database)/documents/messes/$(messId))
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(ratingId)
          && isValidMealRating(incoming(), messId)
          && existing().authorId == request.auth.uid
          && incoming().authorId == existing().authorId
          && incoming().messId == existing().messId
          && incoming().date == existing().date
          && incoming().mealType == existing().mealType
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'rating', 'hygieneRating', 'portionAdequate', 'comment', 'authorName', 'updatedAt'
          ]);
        allow delete: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(ratingId)
          && (existing().authorId == request.auth.uid || isMessOperator(messId) || isAdmin());
      }

      match /complaints/{complaintId} {
        allow get: if isSignedIn() && isValidId(messId) && isValidId(complaintId);
        allow list: if isSignedIn() && resource.data.messId == messId;
        allow create: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(complaintId)
          && isValidComplaint(incoming(), messId)
          && exists(/databases/$(database)/documents/messes/$(messId))
          && incoming().authorId == request.auth.uid
          && incoming().status == 'Submitted'
          && incoming().operatorResponse == ''
          && incoming().respondedByName == ''
          && !('resolvedAt' in incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(complaintId)
          && isValidComplaint(incoming(), messId)
          && incoming().messId == existing().messId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              existing().status != 'Resolved' && (
                (
                  existing().authorId == request.auth.uid &&
                  existing().status == 'Submitted' &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'title', 'description', 'category', 'mealType', 'mealDate', 'updatedAt'
                  ])
                ) ||
                (
                  isMessOperator(messId) &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'status', 'operatorResponse', 'respondedByName', 'updatedAt', 'resolvedAt'
                  ]) &&
                  (incoming().status == 'Resolved'
                    ? ('resolvedAt' in incoming() && incoming().resolvedAt == request.time)
                    : !('resolvedAt' in incoming()))
                )
              )
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(messId)
          && isValidId(complaintId)
          && ((existing().authorId == request.auth.uid && existing().status == 'Submitted') || isAdmin());
      }
    }
  }
}
